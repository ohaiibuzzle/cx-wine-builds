From fac159a3cb6e1596b0bebd273f68089f8f44c468 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Thu, 18 Sep 2025 11:50:52 +0200
Subject: [PATCH 5/5] HACK: ntdll: Set WINE_ENABLE_STEAM_STUB for some games.

Based on Proton's hacks_init() function.
---
 dlls/ntdll/unix/loader.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 4cbff10..da6190a 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1393,6 +1393,16 @@ static void hacks_init(void)
 
     env_str = getenv("WINE_SIMULATE_WRITECOPY");
     if (env_str) simulate_writecopy = atoi(env_str);
+
+    if (main_argc > 1 &&
+        (strstr(main_argv[1], "GenshinImpact.exe") ||
+         strstr(main_argv[1], "YuanShen.exe") ||
+         strstr(main_argv[1], "fpsunlock.exe") ||
+         strstr(main_argv[1], "BH3.exe") ||
+         strstr(main_argv[1], "ZenlessZoneZero.exe")))
+    {
+        setenv("WINE_ENABLE_STEAM_STUB", "1", 0);
+    }
 }
 
 
